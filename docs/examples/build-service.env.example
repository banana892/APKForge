# APKForge BuildService configuration example (Phase C.2)
#
# Copy to a private file (e.g. ~/.config/apkforge/build.env), adjust, and load it
# with `set -a; source ~/.config/apkforge/build.env; set +a` before running
# `apkforge build`. Every variable is optional: anything unset is discovered
# (see docs/build-service.md, "Toolchain configuration").
#
# This file contains NO secrets. Never put a keystore password in it.

# --- Java -------------------------------------------------------------------
# JAVA_HOME=/usr/lib/jvm/java-25-openjdk
# APKFORGE_JAVA=/usr/lib/jvm/java-25-openjdk/bin/java
# APKFORGE_KEYTOOL=/usr/lib/jvm/java-25-openjdk/bin/keytool

# --- Apktool (3.0.3+ required) -----------------------------------------------
# A .jar is run as `java -jar`; an executable wrapper is run directly.
# Default in a source checkout: <repo>/tools/apktool.jar
# APKFORGE_APKTOOL=/opt/apktool/apktool_3.0.3.jar

# --- Android SDK ------------------------------------------------------------
# Default: $ANDROID_HOME, $ANDROID_SDK_ROOT, then ~/Android/Sdk
# APKFORGE_ANDROID_SDK=/opt/android-sdk
# Pin components (default: highest installed)
# APKFORGE_BUILD_TOOLS_VERSION=35.0.0
# APKFORGE_ANDROID_PLATFORM=android-35
# Override individual tools (default: <sdk>/build-tools/<version>/...)
# APKFORGE_ZIPALIGN=/opt/android-sdk/build-tools/35.0.0/zipalign
# APKFORGE_APKSIGNER=/opt/android-sdk/build-tools/35.0.0/apksigner

# --- Apktool framework ------------------------------------------------------
# BuildService installs <platform>/android.jar here on first use and records
# its provenance in apkforge-framework.json.
# Default: $XDG_DATA_HOME/apkforge/apktool-framework/<platform>
# APKFORGE_APKTOOL_FRAMEWORK_DIR=/var/lib/apkforge/apktool-framework/android-35

# --- Signing ----------------------------------------------------------------
# Default (nothing set): the APKForge DEVELOPMENT key is generated once in
#   $XDG_DATA_HOME/apkforge/dev-signing/ (override: APKFORGE_DEV_KEY_DIR)
# with a random password in a 0600 file. It is for testing only.
#
# To use a different (still non-production!) key, point at it explicitly.
# The password is read from a file or from a variable you name - never from here.
# APKFORGE_SIGNING_KEYSTORE=/secure/path/test-signing.p12
# APKFORGE_SIGNING_ALIAS=test
# APKFORGE_SIGNING_PASSWORD_FILE=/secure/path/test-signing.password
# APKFORGE_SIGNING_PASSWORD_ENV=MY_TEST_KEYSTORE_PASSWORD   # alternative to the file

# --- Workspaces -------------------------------------------------------------
# CLI: `apkforge build --work-dir DIR`. Default: <tmp>/apkforge/builds/<build-id>/
