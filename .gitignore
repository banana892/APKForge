# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg
MANIFEST
.eggs/

# Virtual environments
.venv/
.venv-validation/
venv/
env/
.env

# Pytest / coverage
.pytest_cache/
.coverage
htmlcov/
.tox/

# Mypy
.mypy_cache/

# Ruff
.ruff_cache/

# IDE / editor
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# APK / Android artefacts — never commit binaries or rebuilds
*.apk
*.apks
*.xapk
*.aab
*.jar
*.zip

# Third-party decompiled code and generated build trees
**/decoded/
workspace/
tmp/
.apkforge_tmp/
work/
samples/
artifacts/**/test_a/
artifacts/**/test_b/

# Logs
*.log
logs/

# Exception: small toolchain evidence logs that back a reported acceptance result
# (apktool build / zipalign / apksigner sign+verify output). These are cited as
# evidence by the close-out reports, so they must stay reviewable. Build outputs
# themselves (APKs, decoded trees) remain ignored by the rules above.
!artifacts/toolchain-validation/closeout/**/*.log

# Secrets / keys
*.keystore
*.jks
*.p12
*.pem
*.key
*.crt
*.pfx
