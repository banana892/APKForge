#!/usr/bin/env bash
# Wrapper for Android SDK zipalign
set -euo pipefail

ZIPALIGN_BIN="${ANDROID_SDK_ROOT:-/home/naishring/Android/Sdk}/build-tools/35.0.0/zipalign"
if [ ! -x "${ZIPALIGN_BIN}" ]; then
    ZIPALIGN_BIN="${ANDROID_SDK_ROOT:-/home/naishring/Android/Sdk}/build-tools/34.0.0/zipalign"
fi

if [ ! -x "${ZIPALIGN_BIN}" ]; then
    echo "ERROR: zipalign executable not found at ${ZIPALIGN_BIN}" >&2
    exit 1
fi

exec "${ZIPALIGN_BIN}" "$@"
